/*
 * La flash interne du STM32F750N8 ne fait que 64 Ko : trop petit pour LVGL.
 * On redirige l'execution de l'appli vers la fenetre memoire-mappee du
 * QSPI externe (n25q128a1, 16 Mo), exposee par le controleur QUADSPI a
 * l'adresse 0x90000000.
 *
 * zephyr/dts/arm/st/f7/stm32f7.dtsi definit deja un noeud tout fait pour
 * cette fenetre : "quadspi_memory" (memory-placeholder@90000000, 256 Mo).
 * On le reutilise plutot que de creer un noeud concurrent a la meme adresse
 * - juste besoin de reduire sa taille a ce qu'on reserve reellement pour
 * l'appli (1 Mo, a l'offset 0 de la puce QSPI, comme "slot1_partition"/
 * "image-1" deja defini dans le devicetree du board mais non utilise
 * ailleurs dans ce workspace) et de le designer comme zephyr,flash.
 *
 * Ce n'est pas un vrai flash-controller : Kconfig derive
 * CONFIG_FLASH_BASE_ADDRESS/CONFIG_FLASH_SIZE juste depuis la propriete
 * "reg" du noeud chosen "zephyr,flash" (voir zephyr/scripts/kconfig/
 * kconfigfunctions.py, fonction dt_chosen_reg), sans exiger de binding
 * particulier - meme mecanisme que le noeud "sdram1" deja utilise dans
 * main.c pour placer le framebuffer en SDRAM externe.
 */

/ {
	chosen {
		zephyr,flash = &quadspi_memory;
	};
};

&quadspi_memory {
	reg = <0x90000000 0x00100000>; /* 1 Mo, au lieu des 256 Mo par defaut */
	zephyr,memory-region = "QSPI_XIP";

	/*
	 * quadspi_memory herite par defaut de zephyr,memory-attr =
	 * ATTR_MPU_EXTMEM (stm32f7.dtsi), qui genere une region MPU
	 * additionnelle NO_ACCESS (REGION_EXTMEM_ATTR, voir
	 * zephyr/include/zephyr/arch/arm/mpu/arm_mpu_v7m.h). Cette region est
	 * programmee a un index MPU plus eleve que la region statique
	 * "FLASH_0" (deja RO+executable, derivee automatiquement de
	 * CONFIG_FLASH_BASE_ADDRESS/SIZE via le chosen zephyr,flash
	 * ci-dessus) - et sur ARMv7-M, en cas de chevauchement, c'est la
	 * region de plus haut index qui gagne. Resultat : la region
	 * NO_ACCESS ecrasait silencieusement FLASH_0 sur toute la fenetre
	 * QSPI, provoquant un HardFault (Instruction Access Violation) des
	 * qu'on tentait d'executer du code depuis 0x90000000.
	 *
	 * boot_qspi corrige ce meme heritage avec ATTR_MPU_IO, mais ce
	 * n'est pas transposable ici : IO/Device est une region
	 * architecturalement non-executable sur ARM (independamment du bit
	 * XN), alors que Projet1 doit justement executer son code depuis
	 * cette fenetre (contrairement a boot_qspi qui ne fait que sauter
	 * par-dessus). La region FLASH_0 statique etant deja correcte, il
	 * suffit de supprimer l'attribut herite pour empecher la generation
	 * de la region fantome.
	 */
	/delete-property/ zephyr,memory-attr;
};

/*
 * ADC1, canal 0 (ADC1_IN0) sur PA0.
 *
 * adc1_in0_pa0 est le noeud pinctrl standard fourni par
 * modules/hal/stm32/dts/st/f7/stm32f750n8hx-pinctrl.dtsi (inclus par
 * boards/st/stm32f7508_dk/stm32f7508_dk.dts) pour cette combinaison
 * ADC1/canal 0/PA0 - donc pas besoin de le redefinir ici, contrairement
 * a un pin AF classique (UART, SPI...), un pin ADC est simplement bascule
 * en mode analogique par ce noeud.
 *
 * io-channels expose le canal a l'application via adc_dt_spec /
 * DT_IO_CHANNELS_... dans le noeud zephyr,user, comme les autres
 * peripheriques deja references (SDRAM, QSPI) dans ce workspace.
 */
&adc1 {
	pinctrl-0 = <&adc1_in0_pa0>;
	pinctrl-names = "default";
	/* st,adc-clock-source = "SYNC"; deja le defaut dans stm32f7.dtsi, pas besoin de le repeter */
	st,adc-prescaler = <4>;
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};


&adc3 {
	pinctrl-0 = <&adc3_in8_pf10> , <&adc3_in7_pf9> , <&adc3_in6_pf8>;
	pinctrl-names = "default";
	st,adc-prescaler = <4>;
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	channel@8 {
		reg = <8>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
	channel@6 {
		reg = <6>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};


/ {
	zephyr,user {
		io-channels = <&adc1 0>, <&adc3 8>, <&adc3 7>, <&adc3 6>;
		io-channel-names = "pot0", "pot1", "pot2", "pot3";
	};
};


/*
 * Internal flash (64 KB) too small for LVGL: the app runs XIP from external
 * QSPI at 0x90000000 (stm32f7.dtsi "quadspi_memory", shrunk to 1 MB).
 */

/ {
	chosen {
		zephyr,flash = &quadspi_memory;
	};
};

&quadspi_memory {
	reg = <0x90000000 0x00100000>; /* 1 MB, not the 256 MB default */
	zephyr,memory-region = "QSPI_XIP";

	/*
	 * Dropped: the inherited ATTR_MPU_EXTMEM (stm32f7.dtsi) shadowed
	 * FLASH_0 with a NO_ACCESS region, HardFaulting any execute from
	 * 0x90000000 (see bootloader-qspi.md).
	 */
	/delete-property/ zephyr,memory-attr;
};

/*
 * ADC1 is disabled by default in stm32f7.dtsi; die_temp/vref below use its
 * internal channels (17/18) directly - no pinctrl or DMA.
 */
&adc1 {
	st,adc-prescaler = <4>;
	status = "okay";
};

/*
 * die_temp/vref: ready-made stm32f7.dtsi nodes, just disabled by default;
 * src/temperature.c handles multiplexing and calibration.
 */
&die_temp {
	status = "okay";
};

&vref {
	status = "okay";
};

&usart1 {
	current-speed = <9600>;
};

/*
 * MPU6050 on I2C1 (PB8/PB9 = Arduino D15/D14; i2c1 already enabled in
 * stm32f7508_dk.dts). AD0 tied to GND -> address 0x68.
 */
&i2c1 {
	mpu6050: mpu6050@68 {
		compatible = "invensense,mpu6050";
		reg = <0x68>;
	};
};

/*
 * IWDG: ready-made stm32f7.dtsi node, disabled by default; runs off its own
 * LSI timer. Configured and fed from src/watchdog.c.
 */
&iwdg {
	status = "okay";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		highscore_partition: partition@8000 {
			label = "highscore";
			reg = <0x00008000 DT_SIZE_K(32)>;
		};
	};
};


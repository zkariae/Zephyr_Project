/*
 * Internal flash (64 KB) is too small for LVGL: the app runs XIP from
 * external QSPI at 0x90000000, reusing stm32f7.dtsi's "quadspi_memory"
 * node (shrunk to 1 MB) marked as zephyr,flash.
 */

/ {
	chosen {
		zephyr,flash = &quadspi_memory;
	};
};

&quadspi_memory {
	reg = <0x90000000 0x00100000>; /* 1 MB, not the 256 MB default */
	zephyr,memory-region = "QSPI_XIP";

	/*
	 * Dropped: the inherited ATTR_MPU_EXTMEM (stm32f7.dtsi) added a
	 * higher-priority NO_ACCESS MPU region that shadowed FLASH_0 and
	 * HardFaulted on any execute from 0x90000000 (see bootloader-qspi.md).
	 */
	/delete-property/ zephyr,memory-attr;
};

/*
 * ADC1 channel 0 (ADC1_IN0) on PA0, using the standard pinctrl node from
 * stm32f750n8hx-pinctrl.dtsi. io-channels below exposes it to the app via
 * adc_dt_spec on the zephyr,user node.
 */
&adc1 {
	pinctrl-0 = <&adc1_in0_pa0>;
	pinctrl-names = "default";
	/* st,adc-clock-source = "SYNC" is already the stm32f7.dtsi default */
	st,adc-prescaler = <4>;
	status = "okay";

	/*
	 * DMA2 Stream0/Channel0, confirmed via STM32CubeMX (RM0385 alone
	 * doesn't disambiguate this pairing among the valid ADC1/ADC3
	 * options on DMA2).
	 */
	dmas = <&dma2 0 0 (STM32_DMA_PERIPH_RX | STM32_DMA_MEM_16BITS |
			   STM32_DMA_PERIPH_16BITS) STM32_DMA_FIFO_FULL>;
	dma-names = "dma";

	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};


&adc3 {
	pinctrl-0 = <&adc3_in8_pf10> , <&adc3_in7_pf9> , <&adc3_in6_pf8>;
	pinctrl-names = "default";
	st,adc-prescaler = <4>;
	status = "okay";

	/*
	 * DMA2 Stream1/Channel2 - distinct from ADC1's Stream0 since both
	 * run in parallel and can't share a hardware stream. Confirmed via
	 * STM32CubeMX.
	 */
	dmas = <&dma2 1 2 (STM32_DMA_PERIPH_RX | STM32_DMA_MEM_16BITS |
			   STM32_DMA_PERIPH_16BITS) STM32_DMA_FIFO_FULL>;
	dma-names = "dma";

	#address-cells = <1>;
	#size-cells = <0>;

	channel@8 {
		reg = <8>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
	channel@6 {
		reg = <6>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&dma2 {
	status = "okay";
};


/ {
	zephyr,user {
		io-channels = <&adc1 0>, <&adc3 8>, <&adc3 7>, <&adc3 6>;
		io-channel-names = "pot0", "pot1", "pot2", "pot3";
	};
};

/*
 * Internal die temperature and VREFINT: ready-made nodes from
 * stm32f7.dtsi, just disabled by default. Both go through ADC1
 * (internal channels, no pinctrl needed); src/temperature.c handles
 * multiplexing and calibration.
 */
&die_temp {
	status = "okay";
};

&vref {
	status = "okay";
};

&usart1 {
	current-speed = <9600>;
};

/*
 * Hardware IWDG watchdog: ready-made stm32f7.dtsi node, just disabled
 * by default. Runs off its own LSI timer, independent of the core -
 * resets the board if it stops being fed. Configured and fed from
 * src/watchdog.c.
 */
&iwdg {
	status = "okay";
};

